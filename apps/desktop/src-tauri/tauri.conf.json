{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataForge",
  "version": "0.1.0",
  "identifier": "dev.dataforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DataForge", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600, "backgroundColor": "#242424" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": [] }
}
