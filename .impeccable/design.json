  "narrative": {
    "northStar": "The Analytical Workbench",
    "overview": "DataForge's current interface is quiet, compact, and technical. It uses a stable desktop shell, clear work areas, dense controls, and restrained status cues so datasets and analytical work carry the attention. Its visual language is tactile but quiet: a hover, selection, or focus cue clarifies an action without shifting the layout.",
    "keyCharacteristics": [
      "Compact three-region desktop shell with a centered mode selector.",
      "Dark neutral surfaces separated by fine borders and modest tonal changes.",
      "Small, consistent controls with clear keyboard focus.",
      "Data tables and notebook content treated as working material, not decorative cards."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Choose the existing role token for each new element; define a new role in `spec/DESIGN_SYSTEM.md` and the shared foundation before repeating it across screens.",
        "section": "colors"
      },
      {
        "name": "The Data First Rule",
        "body": "Use the type roles to clarify data and actions; keep long technical values selectable and allow names to truncate only where the full value remains accessible.",
        "section": "typography"
      },
      {
        "name": "The Shared Workspace Rule",
        "body": "Keep navigation, center work, contextual inspection, and the composer in their established relationships; give Notebook its dedicated document workspace.",
        "section": "layout"
      },
      {
        "name": "The Restrained Float Rule",
        "body": "Reserve shadow for a surface that actually floats above the workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the shared components, semantic color roles, 4 px spacing scale, and documented control heights.",
      "Do keep keyboard focus visible and include text or an icon with status color.",
      "Do review both normal and narrow desktop layouts when changing a screen."
    ],
    "donts": [
      "Don't introduce gradients, glow, oversized cards, or a second icon language into this workbench.",
      "Don't create local near-match colors, ad hoc field heights, or parallel button and input systems.",
      "Don't use a control's appearance to imply an agent, execution runtime, or report capability that is not implemented."
    ]
  }
}
